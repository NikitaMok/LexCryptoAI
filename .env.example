# --- Приложение ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM: yandexgpt | gigachat ---
LLM_PROVIDER=gigachat
LLM_TEMPERATURE=0.0

YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=

GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra

# --- PostgreSQL: база правил, метаданные, обратная связь ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lexcrypto
POSTGRES_USER=lexcrypto
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://lexcrypto:@localhost:5432/lexcrypto

# --- Chroma / эмбеддинги ---
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=legal_norms
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DENSE_SEARCH=false

# --- AML: публичные RPC, ключи бесплатного тарифа ---
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
AML_RISK_THRESHOLD=50

# --- Загрузка контрактов: файлы удаляются сразу после генерации отчёта ---
UPLOAD_TMP_DIR=tmp/uploads
MAX_UPLOAD_MB=20

# --- Human-in-the-loop ---
HITL_CONFIDENCE_THRESHOLD=0.8

# --- Мониторинг ---
SENTRY_DSN=
METRICS_ENABLED=true
