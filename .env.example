# --- Приложение ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Локальная модель: текст договора на эту машину не покидает ---
# Значение по умолчанию совпадает с config/providers.yaml.
# Сменить модель: строка ниже (перекрывает yaml). Потом: ollama pull <имя>
# Легковесные и средние модели для разбора договора не ставить.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.3:70b
LLM_TEMPERATURE=0.0

# --- Эмбеддинги корпуса норм ---
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=legal_norms
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DENSE_SEARCH=false

# --- Кошелёк: в интернет уходит только номер адреса ---
# Бесплатный режим работает без ключей (TRON). ERC-20 — бесплатный ключ Etherscan.
# Оценка адреса идёт в том же прогоне, что и договор.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
AML_RISK_THRESHOLD=50
OLLAMA_TIMEOUT_S=300

# Платные скоринги адреса. Выключены в config/providers.yaml (enabled: false).
# Чтобы включить: enabled: true у нужной записи и ключ здесь.
# CHAINALYSIS_API_KEY=
# ELLIPTIC_API_KEY=
# BITOK_API_KEY=

# Платные карточки контрагента. То же: yaml enabled: true + ключ здесь.
# KONTUR_FOCUS_KEY=
# SPARK_API_KEY=
# SBIS_API_KEY=

# --- Загрузка: файл удаляется сразу после отчёта ---
UPLOAD_TMP_DIR=tmp/uploads
MAX_UPLOAD_MB=20
